# ============================================================================
# SGG — Variables de entorno (producción, generadas por install.sh)
#
# Este archivo lo genera install.sh con secrets aleatorios de openssl.
# No editar a mano salvo que sepas lo que hacés. Guardar backup fuera de la
# máquina; sin estas variables no se puede restaurar backups pgBackRest.
# ============================================================================

# Versión de las imágenes de GHCR a usar. Bumpeada por `sgg update`.
SGG_VERSION="0.2.7"

# ----------------------------------------------------------------------------
# PostgreSQL
# ----------------------------------------------------------------------------
POSTGRES_USER="sgg"
POSTGRES_PASSWORD=""   # openssl rand -base64 32
POSTGRES_DB="sgg"

# ----------------------------------------------------------------------------
# API (JWT + refresh tokens). GENERADOS por install.sh.
# ----------------------------------------------------------------------------
JWT_SECRET=""                    # openssl rand -hex 64
JWT_EXPIRES_IN="30m"
REFRESH_TOKEN_SECRET=""          # openssl rand -hex 64
REFRESH_TOKEN_EXPIRES_IN_DAYS="30"

# Flag `Secure` en las cookies de auth. Chrome descarta cookies Secure sobre
# HTTP → el login queda en loop invisible. Default false para pilot en LAN
# sin TLS. Cuando sirvas detrás de reverse-proxy HTTPS (Caddy, nginx,
# Cloudflare), setear true.
COOKIE_SECURE="false"

# CORS: el navegador ve el web en el puerto 3000 del host.
# Si servís detrás de nginx/traefik, cambiar por el hostname público.
CORS_ORIGIN="http://localhost:3000"

# ----------------------------------------------------------------------------
# Backups (pgBackRest). CIFRA WAL + full backups con AES-256.
# PERDER esta variable = perder los backups. Guardar copia fuera de la máquina.
# ----------------------------------------------------------------------------
PGBACKREST_REPO_CIPHER_PASS=""   # openssl rand -base64 32

# ----------------------------------------------------------------------------
# Admin inicial (creado por seed en el primer up). install.sh imprime la
# password UNA vez al final; después cambiala desde la UI.
# ----------------------------------------------------------------------------
SEED_ADMIN_EMAIL="admin@sgg.local"
SEED_ADMIN_PASSWORD=""           # openssl rand -base64 24 (impreso una vez)
SEED_ADMIN_NAME="Administrador SGG"

# ----------------------------------------------------------------------------
# Observabilidad
# ----------------------------------------------------------------------------
LOG_LEVEL="info"
METRICS_ENABLED="true"

# ----------------------------------------------------------------------------
# Auto-update (docs/plans/autoupdate-plan.md). Las claves nuevas llegan a
# instalaciones existentes vía el merge del self-update de `sgg` (§12.1).
# ----------------------------------------------------------------------------
# Canal de actualización: patch | minor | off.
# off = sin auto-update; el toast queda como aviso informativo.
SGG_UPDATE_CHANNEL="patch"

# Ventana de mantenimiento, hora local de la VM (formato HH:MM-HH:MM).
SGG_UPDATE_WINDOW="03:00-05:00"

# Horas hasta el backstop de aplicación forzada (§7.2).
SGG_UPDATE_DEADLINE_HOURS="72"

# Token del agente. Generado por install.sh con openssl rand -hex 32.
# Vacío = los endpoints internos del agente rechazan todo.
SGG_AGENT_TOKEN=""

# Nombre humano de la instalación (aparece en el webhook de alertas §15).
# Vacío = hostname de la VM.
SGG_INSTANCE_NAME=""

# Opcional. Vacío = sólo log local. Acepta cualquier URL que reciba POST
# (Discord, ntfy.sh, lo que sea) al fallar un update (§15).
SGG_ALERT_WEBHOOK=""
